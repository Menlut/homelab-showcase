###########################################################
# Host User
###########################################################

PUID=1000
PGID=1000

TZ=America/New_York


###########################################################
# Stirling PDF
###########################################################

# Localhost port used by Caddy.
STIRLING_PDF_PORT=61213

# Default interface language.
STIRLING_DEFAULT_LOCALE=en-US

STIRLING_PDF_URL=https://pdf.example.com

# Maximum upload size.
#
# Stirling supports values such as:
#   500MB
#   1GB
#   2GB
STIRLING_FILE_UPLOAD_LIMIT=3GB

###########################################################
# Stirling PDF - Authentik SSO
###########################################################

STIRLING_OIDC_ISSUER=https://auth.example.com/application/o/stirling-pdf/
STIRLING_OIDC_CLIENT_ID=
STIRLING_OIDC_CLIENT_SECRET=
