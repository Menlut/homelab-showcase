TZ=America/New_York

# Public/internal URL through Caddy
MEALIE_BASE_URL=https://mealie.example.com
MEALIE_DATA_PATH=/srv/homelab/mealie/data

# Initial Mealie configuration
MEALIE_DEFAULT_GROUP=Default
MEALIE_DEFAULT_HOUSEHOLD=Home

# PostgreSQL
MEALIE_DB_NAME=mealie
MEALIE_DB_USER=mealie
MEALIE_DB_PASSWORD=

MEALIE_URL=http://127.0.0.1:9925
MEALIE_TOKEN=

###########################################################
# Mealie - Authentik OIDC
###########################################################

# Authentik discovery endpoint.
#
# Replace auth.example.com with your own Authentik hostname.
MEALIE_OIDC_CONFIGURATION_URL=https://auth.example.com/application/o/mealie/.well-known/openid-configuration

# OAuth2 client credentials generated in Authentik.
MEALIE_OIDC_CLIENT_ID=
MEALIE_OIDC_CLIENT_SECRET=
