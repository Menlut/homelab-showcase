###########################################################
# Host / Container User
###########################################################

# Run Valheim and Vikinger-created files as the normal
# homelab user rather than root.
PUID=1000
PGID=1000

# Shared timezone used by Valheim's cron jobs.
TZ=America/New_York


###########################################################
# Valheim Server
###########################################################

SERVER_NAME=''
WORLD_NAME=''
SERVER_PASS=''
SERVER_PUBLIC='false'

# Allows metals/ore/etc. through portals.
SERVER_ARGS='-modifier portals casual'

MAX_PLAYERS=10

###########################################################
# Valheim Server Ports
###########################################################
VALHEIM_PORT_1=2456
VALHEIM_PORT_2=2457
VALHEIM_PORT_3=2458

###########################################################
# Mods
###########################################################

# Enable BepInEx support.
BEPINEX='true'

# Do not use ValheimPlus at the same time as BepInEx.
VALHEIM_PLUS='false'

# Stay on the normal Valheim release branch.
PUBLIC_TEST='false'

# Leave disabled unless you specifically need Xbox /
# Microsoft Store / other cross-platform clients.
CROSSPLAY='false'


###########################################################
# Backups
###########################################################

BACKUPS='true'

# Create a backup every hour.
BACKUPS_CRON='0 * * * *'

# Keep backups for up to 30 days.
BACKUPS_MAX_AGE='30'

# 0 = no maximum count.
#
# BACKUPS_MAX_AGE still removes backups older than 30 days.
BACKUPS_MAX_COUNT='0'

# true means scheduled backups continue even when the server
# has been idle / nobody has recently been connected.
BACKUPS_IF_IDLE='true'

# Compress world backups.
BACKUPS_ZIP='true'


###########################################################
# Game Updates
###########################################################

# Check for Valheim game updates every day at noon.
#
# This updates the Valheim dedicated-server files INSIDE the
# container. It is separate from WUD updating the Docker image.
UPDATE_CRON='0 12 * * *'

# Do not update/restart the game while players are online.
UPDATE_IF_IDLE='true'


###########################################################
# Scheduled Server Restart
###########################################################

# The upstream image normally performs a scheduled restart
# at 05:10. Make that behavior explicit instead of silently
# relying on the image default.
RESTART_CRON='10 5 * * *'

# Only perform the scheduled restart while no players are
# connected.
RESTART_IF_IDLE='true'


###########################################################
# File Permissions
###########################################################

# Standard 755-directory / 644-file behavior.
PERMISSIONS_UMASK='022'


###########################################################
# Vikinger Panel
###########################################################

HOST_PROJECT_DIR=/home/homelab/docker/game-servers/valheim

# Host-side panel port.
#
# Caddy proxies to:
#   127.0.0.1:8088
PANEL_PORT=8088

# Set using: getent group docker | cut -d: -f3
DOCKER_GID=
# Panel language.
PANEL_DEFAULT_LOCALE=en-US


###########################################################
# RCON / ValheimRcon
###########################################################

# Vikinger automatically generates the RCON password when
# Modded/BepInEx mode is enabled.
#
# These normally do NOT need to be manually configured.
# Uncomment only if we need to override Vikinger's defaults.

# PANEL_RCON_HOST=valheim
# PANEL_RCON_PORT=
# PANEL_RCON_PASSWORD=

# Normal RCON timeout.
PANEL_RCON_TIMEOUT=15

# Timeout for slower RCON operations.
PANEL_RCON_TIMEOUT_SLOW=90

# Idle delay for slower RCON operations.
PANEL_RCON_IDLE_SLOW=3


###########################################################
# Discord
###########################################################

# This variable is intended for Vikinger's E2E testing only.
# Do NOT put your normal Discord notification webhook here.
#
# Configure normal Discord notifications from:
#
#   Vikinger Panel -> Discord
#
# DISCORD_TEST_WEBHOOK_URL=
