# PUBLIC EXAMPLES: actual environment files and credentials must never be committed.
**/.env
**/.env.*
!**/.env.example

# Secrets, certificates, local credentials.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/.ssh/
**/.gnupg/
**/id_rsa
**/id_ed25519
**/secrets/

# Runtime data, databases, generated state and archives.
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-shm
**/*.db-wal
**/*-journal
**/*.log
**/*.tmp
**/*.swp
**/*.bak
**/*.backup
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.7z
**/*.sql
**/*.sql.gz
**/*.dll
**/__pycache__/
**/*.py[cod]
**/.cache/
**/.DS_Store
**/Thumbs.db
**/backups/
**/backup/

# Compose bind-mount state: retain example configurations, not their data.
/hosts/beelink/docker/**/config/
/hosts/beelink/docker/**/data/
/hosts/beelink/docker/**/workspace/
/hosts/beelink/docker/**/store/
/hosts/beelink/docker/**/postgres_data/
/hosts/beelink/docker/**/redis_data/
/hosts/beelink/docker/**/wardrobe_data/
/hosts/beelink/docker/**/beszel_data/
/hosts/beelink/docker/**/beszel_socket/
/hosts/beelink/docker/**/beszel_agent_data/
/hosts/beelink/docker/**/adguard-conf/
/hosts/beelink/docker/**/adguard-work/
/hosts/beelink/docker/**/authentik-certs/
/hosts/beelink/docker/**/authentik-data/
/hosts/beelink/docker/**/authentik-postgres-data/
/hosts/beelink/docker/**/authentik-templates/
/hosts/beelink/docker/**/caddy-data/
/hosts/beelink/docker/**/caddy-config/
/hosts/beelink/docker/**/pgadmin-data/
/hosts/beelink/docker/**/portanier-data/
/hosts/beelink/docker/**/uptime-kuma-data/
/hosts/beelink/docker/**/mealie-postgres-data/
/hosts/beelink/docker/**/stirling-configs/
/hosts/beelink/docker/**/stirling-customFiles/
/hosts/beelink/docker/**/stirling-logs/
/hosts/beelink/docker/**/stirling-tessdata/
/hosts/beelink/docker/**/jellyfincache/
/hosts/beelink/docker/**/jellyfinconfig/
/hosts/beelink/docker/**/seerrconfig/
/hosts/beelink/docker/**/*config/
/hosts/beelink/docker/**/*data/

# Additional credential stores, database exports and local IDE metadata.
**/*.jks
**/*.keystore
**/*.dump
**/.vscode/
**/.idea/
